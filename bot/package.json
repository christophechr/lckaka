{
  "name": "lck-weekly-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "send": "tsx src/send.ts",
    "send:lec": "tsx src/send.ts LEC",
    "preview": "tsx src/preview.ts",
    "register:commands": "tsx src/bot/register-commands.ts",
    "verify:discord": "tsx scripts/verify-discord.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:db": "vitest run tests/db.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
